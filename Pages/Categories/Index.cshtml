
@page
@model ChurchOrganizationSystem.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Member Categories";
}

<h1 class="mb-4">Member Categories</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <strong>Add Category</strong>
    </div>

    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.CategoryName"
                       class="form-label"></label>
                <input asp-for="Input.CategoryName"
                       class="form-control"
                       placeholder="e.g. Youth" />
                <span asp-validation-for="Input.CategoryName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description"
                       class="form-label"></label>
                <textarea asp-for="Input.Description"
                          class="form-control"
                          rows="2"
                          placeholder="Optional description"></textarea>
                <span asp-validation-for="Input.Description"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Add Category
            </button>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <strong>Existing Categories (@Model.Categories.Count)</strong>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Date Created</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Categories.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center">
                            No categories found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td>@category.CategoryId</td>
                            <td>@category.CategoryName</td>
                            <td>@(category.Description ?? "—")</td>
                            <td>@category.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-page="/Index" class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
