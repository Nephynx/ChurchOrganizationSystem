
@page
@model ChurchOrganizationSystem.Pages.Groups.IndexModel

@{
    ViewData["Title"] = "Manage Groups";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Manage Church Groups</h1>
        <a asp-page="/Index" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Add New Group</h5>
        </div>

        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.GroupName"
                           class="form-label"></label>
                    <input asp-for="Input.GroupName"
                           class="form-control"
                           placeholder="e.g. Prayer Team" />
                    <span asp-validation-for="Input.GroupName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Description"
                           class="form-label"></label>
                    <textarea asp-for="Input.Description"
                              class="form-control"
                              rows="2"
                              placeholder="Describe the group"></textarea>
                    <span asp-validation-for="Input.Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.LeaderName"
                           class="form-label"></label>
                    <input asp-for="Input.LeaderName"
                           class="form-control"
                           placeholder="Optional" />
                    <span asp-validation-for="Input.LeaderName"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Add Group
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Existing Groups (@Model.Groups.Count)</h5>
        </div>

        <div class="card-body">
            @if (Model.Groups.Count == 0)
            {
                <p class="text-muted mb-0">No groups found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Group Name</th>
                                <th>Description</th>
                                <th>Leader</th>
                                <th>Date Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in Model.Groups)
                            {
                                <tr>
                                    <td>@group.GroupName</td>
                                    <td>@(group.Description ?? "—")</td>
                                    <td>@(group.LeaderName ?? "Not assigned")</td>
                                    <td>@group.CreatedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
